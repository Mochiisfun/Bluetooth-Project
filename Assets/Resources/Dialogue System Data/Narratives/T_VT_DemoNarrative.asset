      <HideCharacter>k__BackingField: 0
      <DialogueEvent>k__BackingField:
        m_PersistentCalls:
          m_Calls: []
    position: {x: 1473, y: 270}
    transitionNode: 0
    entryPoint: 0
    isCheckpoint: 0
    disableAlreadyChosenOptions: 0
  - guid: d9d135d9-8040-458f-b2dd-3cbec1ef931f
    dialogue:
    - <CharacterName>k__BackingField: A Yanky looking guy
      <Content>k__BackingField: '"Ok, Ok<p:normal>, you don''t have to look at me
        like that.<p:normal> I am just an employee in a caffe right there.<p:normal>
        If you want to take a break pls come by.

        <add:VtuberAffection:10>"'
      <HideCharacter>k__BackingField: 0
      <DialogueEvent>k__BackingField:
        m_PersistentCalls:
          m_Calls: []
    - <CharacterName>k__BackingField: Vtuber
      <Content>k__BackingField: <em:happy>He<p:tiny>he<p:normal>, I think<p:short>
        there seem to be some kind of misunderstanding.
      <HideCharacter>k__BackingField: 0
      <DialogueEvent>k__BackingField:
        m_PersistentCalls:
          m_Calls: []
    - <CharacterName>k__BackingField: You
      <Content>k__BackingField: Huh?<p:normal> So he?<p:normal> Uhh~<p:long> never
        mind.
      <HideCharacter>k__BackingField: 0
      <DialogueEvent>k__BackingField:
        m_PersistentCalls:
          m_Calls: []
    position: {x: 2056, y: 58}
    transitionNode: 1
    entryPoint: 0
    isCheckpoint: 0
    disableAlreadyChosenOptions: 0
  - guid: 53d158f4-45e3-481b-8daa-309739d29dfd
    dialogue:
    - <CharacterName>k__BackingField: A Yanky looking guy
