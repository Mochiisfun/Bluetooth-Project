  - guid: 68be2dc4-8928-4fbe-985a-97ddcd3cd7b5
    dialogue:
    - <CharacterName>k__BackingField: You
      <Content>k__BackingField: Sorry to keep you waiting. <add:VtuberAffection:5><add:VtuberSuspicion:-3>
